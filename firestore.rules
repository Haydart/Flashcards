rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // meta/seed (ADR-0039) is the cache-generation freshness signal: a monotonic int
    // bumped by seed_firestore.py at the end of every import run. Read-only to clients,
    // same as categories/subcategories/shards below — written only by the Admin SDK.
    match /meta/seed {
      allow read: if request.auth != null;
    }

    // categories/subcategories/shards (flashcard content) are curated shared
    // content with no owner field; clients may read but only the Admin SDK
    // (which bypasses these rules) may write.
    match /categories/{categoryId} {
      allow read: if request.auth != null;
    }

    match /subcategories/{subcategoryId} {
      allow read: if request.auth != null;

      // Cards are packed into byte-budgeted shard docs, not one doc per card
      // (ADR-0037) — the collection is named `shards`, not `flashcards`.
      match /shards/{shardId} {
        allow read: if request.auth != null;
      }
    }

    match /users/{uid} {
      match /voiceAnswers/{answerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /curationRequests/{requestId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // sessions/{sessionId} (ADR-0014): one document per finished Study Session, committed once
      // at the Session Summary screen and never edited afterward — create-only, not update/delete,
      // so a client can neither rewrite nor erase its own study history. This also closes CR-69 #6
      // (duplicate-sessionId re-commit) as a side effect: Firestore batches are all-or-nothing
      // against rules, so a retried commit's session-doc create fails the whole batch, including
      // the summary increments that would otherwise double-apply — no separate idempotency guard
      // needed.
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
      }

      // progress/{docId} (ADR-0016): per-user singleton documents — the progress summary
      // (progress/summary) is the first; spec 05's scoring state (progress/user-stats) lands
      // alongside it in the same collection, so this one rule covers both without a further
      // change. progress/details is a fixed anchor document with no fields of its own; its rule
      // below covers the real subcollection it hosts.
      //
      // Deliberately not schema-validated (CR-69 #4): a modified client could in principle forge
      // its own counts, card states or timestamps here. Accepted for now — this is a single-user
      // personal app with no leaderboard, shared ranking or other trust surface a self-forged
      // progress document would exploit. Revisit if a competitive or shared-progress feature ships.
      match /progress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // progress/details/subcategories/{subcategoryId} (ADR-0016): one packed document per
      // Subcategory, holding every card the User has studied in it. Written as part of the same
      // session-commit batch as sessions/{sessionId} above. Nested one hop under the fixed
      // `details` anchor document so `progress` itself holds only per-user singletons.
      match /progress/details/subcategories/{subcategoryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // entitlement: intentionally no rule here -> default deny.
      // Only the Cloud Function (Admin SDK) may read/write it.
    }
  }
}
