rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // categories/subcategories/flashcards are curated shared content with no
    // owner field; clients may read but only the Admin SDK (which bypasses
    // these rules) may write.
    match /categories/{categoryId} {
      allow read: if request.auth != null;
    }

    match /subcategories/{subcategoryId} {
      allow read: if request.auth != null;

      match /flashcards/{cardId} {
        allow read: if request.auth != null;
      }
    }

    match /users/{uid} {
      match /voiceAnswers/{answerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /curationRequests/{requestId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // entitlement: intentionally no rule here -> default deny.
      // Only the Cloud Function (Admin SDK) may read/write it.
    }
  }
}
